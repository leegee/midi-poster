{
  "name": "midi-poster",
  "module": "src/main.tsx",
  "main": "src/main.tsx",
  "private": true,
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "test": "vitest run",
    "test-watch": "vitest",
    "test-ui": "vitest --ui",
    "demo:all": "bun ./src/cli.ts --double true --background \"#315\"  beethoven_symphony_5.svg \"midi/5/*.mid\"",
    "demo:1": "bun ./src/cli.ts --double true --background \"#315\" --blend-mode blend --note-scale-factor 1.8 --min-note-height 1  --soft-notes true --blur 4 --reverb 1.2 --height 300 --width 900 beethoven_symphony_9_1.svg \"midi/9/symphony_9_1_\\(c\\)cvikl.mid\"",
    "demo:2": "bun ./src/cli.ts --double true --background \"#315\" --blend-mode blend --note-scale-factor 1.8 --min-note-height 1  --soft-notes true --blur 4 --reverb 1.2 --height 300 --width 900 beethoven_symphony_9_2.svg \"midi/9/symphony_9_2_\\(c\\)cvikl.mid\""
  },
  "type": "module",
  "devDependencies": {
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^0.15.0",
    "@solidjs/start": "^1.1.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/bun": "latest",
    "@types/yargs": "^17.0.33",
    "@vitest/ui": "3.0.5",
    "jsdom": "^25.0.1",
    "solid-js": "^1.9.9",
    "typescript": "^5.6.3",
    "vinxi": "^0.5.7",
    "vite": "^7.1.9",
    "vite-plugin-solid": "^2.11.9",
    "vitest": "3.0.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@solid-primitives/storage": "^4.3.3",
    "@tonejs/midi": "^2.0.28",
    "beercss": "^3.12.11",
    "canvg": "^4.0.3",
    "fast-glob": "^3.3.3",
    "just-debounce": "^1.1.0",
    "sharp": "^0.34.4",
    "yargs": "^18.0.0"
  }
}