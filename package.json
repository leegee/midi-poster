{
  "name": "midi-svg",
  "module": "src/midi-to-svg",
  "type": "module",
  "private": true,
  "scripts": {
    "demo:all": "bun ./src/cli.ts beethoven_symphony_5_1.svg \"midi/beethoven_symphony_5*.mid\"",
    "demo:1": "bun ./src/cli.ts --height 50 --width 800 beethoven_symphony_5_1.svg \"midi/beethoven_symphony_5_1_\\(c\\)galimberti.mid\"",
    "demo:2": "bun ./src/cli.ts --height 150  beethoven_symphony_5_1.svg \"midi/beethoven_symphony_5_1_\\(c\\)galimberti.mid\"",
    "demo:3": "bun ./src/cli.ts --height 800  beethoven_symphony_5_1.svg \"midi/beethoven_symphony_5_1_\\(c\\)galimberti.mid\""
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/yargs": "^17.0.33"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "fast-glob": "^3.3.3",
    "sharp": "^0.34.4",
    "yargs": "^18.0.0"
  }
}